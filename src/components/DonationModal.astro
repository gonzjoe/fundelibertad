---
/**
 * Modal de donación nativo con <dialog> de HTML5 (0 KB de React).
 * Idéntico en diseño, colores, código QR y comportamiento.
 */
import { url } from '../lib/base';
---

<dialog
  id="donation-modal-native"
  class="fixed inset-0 z-50 p-3 sm:p-4 bg-transparent backdrop:bg-slate-950/75 backdrop:backdrop-blur-md max-w-xl w-full m-auto rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 outline-hidden"
>
  <div class="relative w-full overflow-hidden bg-white rounded-3xl" id="donation-modal-window">
    {/* HEADER BRANDING */}
    <div class="bg-slate-900 text-white p-5 sm:p-6 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-sky-500/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="flex justify-between items-start gap-4 relative z-10">
        <div class="flex items-center gap-3.5">
          <div>
            <div class="flex items-center gap-2">
              <span class="bg-sky-500/20 text-sky-300 text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full border border-sky-400/30">
                Canal Institucional de Donaciones
              </span>
              <span class="text-emerald-400 text-[10px] font-semibold flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg> Cuenta Oficial
              </span>
            </div>
            <h2 class="font-display font-extrabold text-xl sm:text-2xl text-white tracking-tight mt-1">
              Apoya la Paz y los Derechos Humanos
            </h2>
            <p class="text-xs text-slate-300 mt-0.5">
              Fundación Fundelibertad • Nit: 900.497.212-2
            </p>
          </div>
        </div>

        <button
          id="close-donation-modal-btn"
          type="button"
          class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-all cursor-pointer shrink-0"
          aria-label="Cerrar modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    {/* MAIN MODAL BODY */}
    <div class="max-h-[75vh] overflow-y-auto p-5 sm:p-7 space-y-6">
      {/* BLOQUE CÓDIGO QR Y DATOS BANCARIOS */}
      <div class="space-y-4" id="donation-qr-code-section">
        <div class="text-center space-y-1.5">
          <span class="bg-sky-100 text-sky-900 text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
            </svg> CÓDIGO QR Y TRANSFERENCIA DIRECTA
          </span>
          <h3 class="font-display font-extrabold text-base sm:text-xl text-slate-900">
            Escanea y Realiza tu Aporte
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
            Puedes realizar tu donación mediante tu aplicación bancaria (Nequi, Bancolombia, Daviplata o Transfiya) escaneando el código QR institucional.
          </p>
        </div>

        {/* QR DISPLAY CARD - CENTERED */}
        <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-sky-950 p-6 rounded-3xl text-white shadow-xl border border-slate-800 flex flex-col items-center justify-center text-center">
          {/* SVG / IMAGE QR CODE CONTAINER */}
          <div class="relative bg-white p-4 sm:p-5 rounded-2xl shadow-lg shrink-0 flex flex-col items-center justify-center border-4 border-slate-800">
            <div class="w-4 h-4 border-t-2 border-l-2 border-sky-500 absolute -top-2 -left-2"></div>
            <div class="w-4 h-4 border-t-2 border-r-2 border-sky-500 absolute -top-2 -right-2"></div>
            <div class="w-4 h-4 border-b-2 border-l-2 border-sky-500 absolute -bottom-2 -left-2"></div>
            <div class="w-4 h-4 border-b-2 border-r-2 border-sky-500 absolute -bottom-2 -right-2"></div>

            <img 
              src="https://lh3.googleusercontent.com/d/1PNcF0uNgCOHdHMeRHLYVO8KjRg7qoNzA" 
              alt="Código QR de Donación" 
              class="w-56 h-56 sm:w-64 sm:h-64 object-contain rounded-lg"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      {/* OPCIONES DE NOTICIAS Y PRIVACIDAD EN LA PARTE INFERIOR */}
      <div class="pt-4 border-t border-slate-100 space-y-2.5 text-xs text-slate-600 font-sans">
        <label class="flex items-start sm:items-center gap-2.5 cursor-pointer">
          <input
            id="chk-receive-news"
            type="checkbox"
            checked
            class="w-4 h-4 mt-0.5 sm:mt-0 rounded text-sky-600 focus:ring-sky-500 border-slate-300"
          />
          <span>Deseo recibir noticias e informes periódicos de la Fundación.</span>
        </label>

        <label class="flex items-start sm:items-center gap-2.5 cursor-pointer">
          <input
            id="chk-accept-privacy"
            type="checkbox"
            checked
            class="w-4 h-4 mt-0.5 sm:mt-0 rounded text-sky-600 focus:ring-sky-500 border-slate-300"
          />
          <span>
            Acepto la <a href={url('/contacto')} target="_blank" class="text-sky-700 underline font-semibold">Política de Privacidad</a> y tratamiento de datos personales.
          </span>
        </label>
      </div>

      {/* TRUST & SECURITY BANNER */}
      <div class="flex items-start gap-2.5 text-[11px] text-slate-500 bg-slate-50 p-3.5 rounded-xl border border-slate-100">
        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <p class="leading-snug">
          <strong class="text-slate-700">Garantía de Transparencia:</strong> Escanea el código QR desde tu aplicación bancaria preferida para realizar tu aporte directo a la Fundación Fundelibertad.
        </p>
      </div>
    </div>
  </div>
</dialog>

<script is:inline>
  // Manejo nativo del modal mediante Event Listener
  const modal = document.getElementById('donation-modal-native');
  const closeBtn = document.getElementById('close-donation-modal-btn');

  window.addEventListener('open-donation-modal', () => {
    if (modal && !modal.open) {
      modal.showModal();
    }
  });

  closeBtn?.addEventListener('click', () => {
    if (modal && modal.open) {
      modal.close();
    }
  });

  // Cerrar al hacer clic en el backdrop
  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    const isInDialog = (
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width
    );
    if (!isInDialog) {
      modal.close();
    }
  });
</script>
