---
/**
 * Footer estático nativo de Astro (0 KB de JavaScript).
 * Mantiene 100% el diseño original, tipografías y enlaces.
 */
import { url } from '../lib/base';
---

<footer class="bg-slate-900 text-slate-300 font-sans border-t border-slate-800" id="main-footer">
  {/* Main Footer Links */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    {/* About segment */}
    <div class="space-y-4">
      <div class="flex items-center">
        <img 
          src="https://lh3.googleusercontent.com/d/1UP_DO2dLXoxqlMWA22JDSSIId4ctprhD"
          alt="FUNDELIBERTAD Logo"
          class="h-8 sm:h-10 w-auto object-contain"
          loading="lazy"
          id="footer-logo-image"
        />
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Fundación de Derechos Humanos por la Libertad y la Vida. Más de 15 años promoviendo la paz, brindando asesoría jurídica gratuita y apoyando el desarrollo de familias y jóvenes vulnerables en la Comuna 15 Guayabal, Medellín.
      </p>
      
      {/* Social media badges */}
      <div class="flex items-center gap-3 pt-2" id="footer-social-links">
        <a
          id="social-instagram-link"
          href="https://www.instagram.com/fundelibertad/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-slate-800 hover:bg-brand-red text-slate-400 hover:text-white rounded-lg transition-colors"
          title="Instagram"
        >
          <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>
        <a
          id="social-facebook-link"
          href="https://www.facebook.com/people/Fundelibertad/100064768600575/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-slate-800 hover:bg-blue-600 text-slate-400 hover:text-white rounded-lg transition-colors"
          title="Facebook"
        >
          <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a
          id="social-youtube-link"
          href="https://www.youtube.com/channel/UCb08vm88UXtzkje2RsoCp-g/videos"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-slate-800 hover:bg-red-600 text-slate-400 hover:text-white rounded-lg transition-colors"
          title="YouTube"
        >
          <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
            <polygon points="10 15 15 12 10 9"/>
          </svg>
        </a>
        <a
          id="social-x-link"
          href="https://x.com/fundelibertad"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white rounded-lg transition-colors"
          title="X (Twitter)"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

    {/* Navigation Quick Links */}
    <div class="space-y-4">
      <h5 class="font-display font-bold text-sm text-white uppercase tracking-wider border-l-2 border-brand-green pl-2.5">
        Enlaces Rápidos
      </h5>
      <ul class="space-y-2.5 text-xs text-slate-400" id="footer-links-quick">
        <li>
          <a href={url('/')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Inicio / Impacto
          </a>
        </li>
        <li>
          <a href={url('/nosotros')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Nuestra Historia y Valores
          </a>
        </li>
        <li>
          <a href={url('/servicios')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Asesorías Gratuitas (19 áreas)
          </a>
        </li>
        <li>
          <a href={url('/proyectos')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Proyectos Sociales en Comuna 15
          </a>
        </li>
        <li>
          <a href={url('/actividades')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Actividades y Eventos
          </a>
        </li>
      </ul>
    </div>

    {/* Programs Quick Links */}
    <div class="space-y-4">
      <h5 class="font-display font-bold text-sm text-white uppercase tracking-wider border-l-2 border-brand-green pl-2.5">
        Canales de Atención
      </h5>
      <ul class="space-y-2.5 text-xs text-slate-400" id="footer-links-programs">
        <li>
          <a href={url('/programas/practicas-pasantias')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Postulación a Prácticas y Pasantías
          </a>
        </li>
        <li>
          <a href={url('/programas/informes-denuncias-ddhh')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Reportar Vulneración de DDHH (Confidencial)
          </a>
        </li>
        <li>
          <a href={url('/programas/asesoria-juridica-comunitaria')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Solicitud de Asesoría Legal Gratuita
          </a>
        </li>
        <li>
          <a href={url('/contacto')} class="hover:text-white hover:underline transition-all cursor-pointer">
            Contacto Directo
          </a>
        </li>
      </ul>
    </div>

    {/* Physical Contact info */}
    <div class="space-y-4">
      <h5 class="font-display font-bold text-sm text-white uppercase tracking-wider border-l-2 border-brand-green pl-2.5">
        Contacto Institucional
      </h5>
      <ul class="space-y-3.5 text-xs text-slate-400" id="footer-contact-info">
        <li class="flex items-start gap-3">
          <svg class="w-4 h-4 text-brand-green shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>
            Calle 1A #55-39<br />
            Barrio El Rodeo, Comuna 15<br />
            Medellín, Colombia
          </span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <a href="https://wa.me/573002167822" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            +57 300 216 7822 (WhatsApp)
          </a>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <a href="mailto:info@fundelibertad.org" class="hover:text-white transition-colors">
            info@fundelibertad.org
          </a>
        </li>
        <li class="pt-2">
          <button
            id="footer-donate-btn"
            onclick="window.dispatchEvent(new CustomEvent('open-donation-modal'))"
            class="w-full py-2 bg-brand-red hover:bg-red-700 text-white font-bold rounded-lg text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-md shadow-red-950/50"
          >
            <svg class="w-3.5 h-3.5 fill-white text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            Donar a la Fundación
          </button>
        </li>
      </ul>
    </div>
  </div>

  {/* Notificaciones Judiciales Box */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12" id="judicial-notifications-container">
    <div class="bg-sky-600 text-white rounded-2xl p-6 shadow-md border border-sky-500/30 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="space-y-2">
        <h6 class="font-sans font-extrabold text-sm uppercase tracking-wider text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          Notificaciones Judiciales
        </h6>
        <p class="text-xs text-sky-50 leading-relaxed max-w-4xl">
          <strong>FUNDELIBERTAD</strong>, en cumplimiento de la Ley 1712 de 2014 y en atención a su calidad de entidad sin ánimo de lucro de conformación mixta, dispuso la cuenta de correo electrónico: <a href="mailto:info@fundelibertad.org" class="underline font-bold hover:text-white transition-colors">info@fundelibertad.org</a> para la atención exclusiva de todas las notificaciones judiciales.
        </p>
      </div>
      <div class="shrink-0 flex items-center">
        <a
          id="judicial-webmail-btn"
          href="https://webmail.fundelibertad.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-sky-700 hover:bg-sky-50 hover:text-sky-800 font-bold text-xs rounded-xl shadow-sm transition-all duration-200 font-sans cursor-pointer whitespace-nowrap"
          title="Ingreso a Webmail Corporativo"
        >
          <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Webmail Institucional</span>
          <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Copy and legal footer */}
  <div class="border-t border-slate-800 bg-slate-950/60 py-6 text-xs text-slate-500 font-mono">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-center md:text-left">
        <p>© {new Date().getFullYear()} FUNDELIBERTAD. Todos los derechos reservados.</p>
        <p class="text-[10px] mt-0.5 text-slate-600">Fundación de Derechos Humanos por la Libertad y la Vida • Nit: 900.497.212-2</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-[10px]">Medellín, Colombia</span>
        <span class="text-slate-700">|</span>
        <span class="text-[10px] text-sky-500/80 font-bold">Paz • Vida • Dignidad</span>
      </div>
    </div>
  </div>
</footer>
