---
import internshipImg from '../../assets/images/fundelibertad_internship_1782489676477.jpg';
import reportsImg from '../../assets/images/fundelibertad_reports_1782489690540.jpg';
import legalImg from '../../assets/images/fundelibertad_legal_1782489703836.jpg';
import AdaptiveImage from '../AdaptiveImage.astro';
import type { WPActivityItem } from './ActivitiesSection.astro';
import { url } from '../../lib/base';

interface Props {
  initialSubsection?: string;
  initialInternshipPosts?: WPActivityItem[];
  initialReportsPosts?: WPActivityItem[];
  initialLegalPosts?: WPActivityItem[];
}

const { 
  initialSubsection = 'internships', 
  initialInternshipPosts = [],
  initialReportsPosts = [],
  initialLegalPosts = []
} = Astro.props;

const SUBSECTION_MAP: Record<string, string> = {
  'internships': 'internships',
  'practicas-pasantias': 'internships',
  'practicas': 'internships',
  'pasantias': 'internships',
  'reports': 'reports',
  'informes-denuncias-ddhh': 'reports',
  'informes-denuncias': 'reports',
  'denuncias': 'reports',
  'legal': 'legal',
  'asesoria-juridica-comunitaria': 'legal',
  'asesoria-juridica': 'legal',
  'asesoria-legal': 'legal'
};

const activeTab = SUBSECTION_MAP[initialSubsection] || initialSubsection;
const internshipPosts = initialInternshipPosts;
const reportsPosts = initialReportsPosts;
const legalPosts = initialLegalPosts;

const getWordExcerpt = (textOrHtml: string, maxWords: number = 50): string => {
  if (!textOrHtml) return '';
  const plain = textOrHtml
    .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
    .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();

  const words = plain.split(' ');
  if (words.length <= maxWords) return plain;
  return words.slice(0, maxWords).join(' ') + '...';
};
