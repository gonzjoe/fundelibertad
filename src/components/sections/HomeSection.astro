</div>

<script>
  function setupHome() {
    const donateButtons = document.querySelectorAll('#hero-donate-btn, #banner-donate-now-btn');
    donateButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-donation-modal'));
      });
    });

    // Sincronización en vivo cliente si no vino pre-cargado
    const fetchLiveWordPressProjects = async () => {
      try {
        const res = await fetch('https://www.csm.fundelibertad.org/wp-json/wp/v2/posts?_embed=1&per_page=50');
        if (!res.ok) return;
        const rawPosts = await res.json();
        if (!Array.isArray(rawPosts)) return;

        const projectPosts = rawPosts.filter((post: any) => {
          if (post.slug === 'hello-world' || post.id === 1) return false;
          const terms: any[] = post._embedded?.['wp:term']?.[0] || [];
          const validTerms = terms.filter((t: any) => {
            const name = (t.name || '').toLowerCase();
            const slug = (t.slug || '').toLowerCase();
            return name !== 'uncategorized' && name !== 'sin categoría' && slug !== 'uncategorized';
          });
          if (validTerms.length === 0) return false;
          return validTerms.some((t: any) => 
            t.slug.toLowerCase().includes('proyecto') || 
            t.name.toLowerCase().includes('proyecto')
          );
        }).slice(0, 3);

        const container = document.getElementById('home-projects-container');
        if (projectPosts.length > 0 && container) {
          const baseUrl = window.location.pathname.startsWith('/fundelibertad') ? '/fundelibertad' : '';
          container.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="home-projects-grid">
              ${projectPosts.map((post: any) => {
                const terms: any[] = post._embedded?.['wp:term']?.[0] || [];
                const catNames = terms.map(t => t.name).filter(c => c.toLowerCase() !== 'uncategorized' && c.toLowerCase() !== 'sin categoría');
                const specificCat = catNames.find(c => c.toLowerCase() !== 'proyectos') || catNames[0] || 'Proyectos';
                const media = post._embedded?.['wp:featuredmedia']?.[0];
                const featuredImg = media?.source_url || media?.media_details?.sizes?.large?.source_url || 'https://lh3.googleusercontent.com/d/11y3-Zw7P020zrMq6cakM0RrvsjrFlzW5';
                const link = `${baseUrl}/blog/${post.slug}`;
                const plainExcerpt = (post.excerpt?.rendered || '').replace(/<[^>]*>?/gm, '').trim();
                const excerptWords = plainExcerpt.split(/\\s+/).filter(Boolean);
                const excerpt = excerptWords.length > 50 ? excerptWords.slice(0, 50).join(' ') + '...' : plainExcerpt;

                return `
                  <div
                    id="project-card-wp-${post.id}"
                    class="bg-white rounded-3xl border border-slate-100 shadow-xs overflow-hidden text-left flex flex-col justify-between hover:shadow-md transition-shadow cursor-pointer group"
                    onclick="window.location.href = '${link}'"
                  >
                    <div>
                      <div class="w-full h-48 relative overflow-hidden bg-slate-100 border-b border-slate-100">
                        <img
                          src="${featuredImg}"
                          alt="${post.title.rendered}"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </div>
                      <div class="p-5 space-y-2">
                        <span class="inline-block px-2.5 py-0.5 rounded-md bg-sky-50 text-[10px] font-bold text-sky-700 uppercase tracking-wider">
                          ${specificCat}
                        </span>
                        <h3 
                          class="font-display font-bold text-sm sm:text-base text-slate-900 leading-snug group-hover:text-sky-700 transition-colors line-clamp-2"
                        >
                          ${post.title.rendered}
                        </h3>
                        <p class="text-xs text-slate-500 leading-relaxed">
                          ${excerpt}
                        </p>
                      </div>
                    </div>
                    <div class="p-5 pt-0">
                      <a
                        href="${link}"
                        onclick="event.stopPropagation()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs shadow-sm hover:shadow transition-all duration-200 group/btn w-fit cursor-pointer"
                      >
                        <span>Leer más</span>
                        <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                      </a>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          `;
        }
      } catch (e) {
        // Fallback gracefully
      }
    };

    fetchLiveWordPressProjects();
  }

  setupHome();
  document.addEventListener('astro:page-load', setupHome);
</script>
