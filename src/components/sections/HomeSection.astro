          id="banner-donate-now-btn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 bg-white hover:bg-slate-50 text-brand-red font-extrabold rounded-xl text-sm transition-all shadow-md hover:shadow-lg cursor-pointer"
        >
          Donar Ahora (Código QR / Transferencia)
        </button>
