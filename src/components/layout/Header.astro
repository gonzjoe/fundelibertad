---
import { url } from '../../lib/base';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const NAV_LINKS = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Actividades', href: '/actividades' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
];

const isActive = (href: string) => {
  const current = currentPath.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return current === '/';
  return current.startsWith(target);
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-2xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      {/* Brand Logo */}
      <a href={url('/')} class="flex items-center gap-3 group focus:outline-hidden" aria-label="Ir al Inicio de FUNDELIBERTAD">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-primary to-brand-dark flex items-center justify-center p-2 shadow-sm group-hover:scale-105 transition-transform">
          <img
            src="https://lh3.googleusercontent.com/d/1nD4GYM2rbdNHtX0xdR3yI0XlC7MQfzps"
            alt="Logo FUNDELIBERTAD"
            class="w-full h-full object-contain filter brightness-0 invert"
            loading="eager"
          />
        </div>
        <div class="flex flex-col text-left">
          <span class="font-display font-black text-xl tracking-tight text-brand-dark group-hover:text-brand-primary transition-colors">
            FUNDELIBERTAD
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">
            Derechos Humanos & Paz
          </span>
        </div>
      </a>

      {/* Desktop Navigation Links */}
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Navegación principal">
        {NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={url(link.href)}
              class={`px-3.5 py-2 rounded-xl text-xs font-bold transition-all ${
                active
                  ? 'bg-brand-primary/10 text-brand-primary font-black'
                  : 'text-slate-600 hover:text-brand-primary hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      {/* Action Buttons (Donar + Mobile Menu Toggle) */}
      <div class="flex items-center gap-3">
        <a
          href={url('/donar')}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-dark text-white font-bold text-xs shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="hidden sm:inline">Apoyar Causa</span>
          <span class="sm:hidden">Donar</span>
        </a>

        {/* 0 KB JS Mobile Navigation via HTML <details> */}
        <details class="lg:hidden relative group">
          <summary class="list-none cursor-pointer p-2 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors focus:outline-hidden" aria-label="Abrir menú de navegación móvil">
            <svg class="w-6 h-6 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-6 h-6 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>

          <div class="absolute right-0 top-full mt-3 w-64 bg-white rounded-2xl shadow-2xl border border-slate-100 p-3 space-y-1 z-50">
            {NAV_LINKS.map((link) => {
              const active = isActive(link.href);
              return (
                <a
                  href={url(link.href)}
                  class={`block px-4 py-2.5 rounded-xl text-xs font-bold transition-all ${
                    active
                      ? 'bg-brand-primary text-white shadow-xs'
                      : 'text-slate-700 hover:bg-slate-50 hover:text-brand-primary'
                  }`}
                >
                  {link.label}
                </a>
              );
            })}
            <div class="pt-2 border-t border-slate-100 mt-2">
              <a
                href="https://wa.me/573002167822"
                target="_blank"
                rel="noopener noreferrer"
                class="block px-4 py-2 text-center rounded-xl bg-emerald-600 text-white font-bold text-xs shadow-xs"
              >
                WhatsApp Comunitario
              </a>
            </div>
          </div>
        </details>
      </div>

    </div>
  </div>
</header>
