---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import DonationModal from '../components/DonationModal.astro';
import { slugify } from '../utils/slugify';
import { url } from '../lib/base';

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  author?: string;
  image?: string;
  category?: string;
  tags?: string[];
  canonicalURL?: string;
}

const {
  title,
  description,
  pubDate,
  author = 'Equipo FUNDELIBERTAD',
  image = 'https://lh3.googleusercontent.com/d/1mzMGHUgDdHcX8hpf8DTMLIs2Dv53CCsd',
  category = 'Derechos Humanos',
  tags = [],
} = Astro.props;

// Regla SEO 2: Canónica limpia sin parámetros de seguimiento
const siteBase = (Astro.site?.href || 'https://fundelibertad.org').replace(/\/$/, '');
let cleanPath = Astro.url.pathname;
if (!cleanPath.includes('.') && !cleanPath.endsWith('/')) {
  cleanPath += '/';
}
const canonicalURL = Astro.props.canonicalURL || `${siteBase}${cleanPath}`;

const dateObj = new Date(pubDate);
const dateIso = dateObj.toISOString();
const dateFormatted = dateObj.toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// JSON-LD Schema BlogPosting
const schemaBlogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: image,
  datePublished: dateIso,
  dateModified: dateIso,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'FUNDELIBERTAD',
    logo: {
      '@type': 'ImageObject',
      url: 'https://lh3.googleusercontent.com/d/1nD4GYM2rbdNHtX0xdR3yI0XlC7MQfzps',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
};
---

<BaseLayout
  title={`${title} | Blog FUNDELIBERTAD`}
  description={description}
  image={image}
  type="article"
  canonicalURL={canonicalURL}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBlogPosting)} />

  <Header currentPath={Astro.url.pathname} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8">
    
    {/* Encabezado del Artículo */}
    <header class="space-y-4 text-center">
      {category && (
        <a
          href={url(`/blog/categoria/${slugify(category)}/`)}
          class="inline-flex px-3.5 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider hover:bg-brand-primary hover:text-white transition-colors"
        >
          {category}
        </a>
      )}

      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl text-brand-dark tracking-tight leading-tight">
        {title}
      </h1>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-slate-400 font-medium pt-2 border-b border-slate-100 pb-6">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={dateIso}>{dateFormatted}</time>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Por {author}
        </span>
      </div>
    </header>

    {/* Imagen Destacada */}
    {image && (
      <div class="rounded-3xl overflow-hidden shadow-xl border border-slate-100 bg-slate-900 aspect-video max-h-[500px]">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    )}

    {/* Contenido Editorial */}
    <div class="prose prose-slate max-w-none bg-white p-6 sm:p-12 rounded-3xl shadow-xs border border-slate-100 leading-relaxed text-base space-y-6">
      <slot />
    </div>

    {/* Etiquetas (Tags) con slugify */}
    {tags && tags.length > 0 && (
      <div class="pt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-400 mr-1">Etiquetas:</span>
        {tags.map((tag) => (
          <a
            href={url(`/blog/etiqueta/${slugify(tag)}/`)}
            class="px-3 py-1 rounded-xl bg-slate-100 text-slate-600 hover:bg-brand-primary hover:text-white transition-colors text-xs font-medium"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    {/* Botón Volver */}
    <div class="pt-6 border-t border-slate-100 flex justify-start">
      <a
        href={url('/blog/')}
        class="inline-flex items-center gap-2 text-xs font-bold text-slate-600 hover:text-brand-primary transition-colors bg-white hover:bg-slate-50 px-5 py-2.5 rounded-xl shadow-xs border border-slate-200 cursor-pointer"
        onclick="if(window.history.length > 1){ window.history.back(); return false; }"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver a todas las publicaciones
      </a>
    </div>

    {/* Institutional Call To Action */}
    <div class="mt-12 bg-gradient-to-r from-sky-50 to-emerald-50 rounded-3xl p-8 border border-sky-100 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="font-display font-bold text-lg text-brand-dark">¿Deseas apoyar nuestra labor comunitaria?</h3>
        <p class="text-xs text-slate-600">Cada donación nos permite defender derechos y brindar asesoría jurídica sin costo.</p>
      </div>
      <div class="flex items-center gap-3">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-donation-modal'))"
          class="px-5 py-2.5 bg-brand-red hover:bg-red-700 text-white font-bold rounded-xl text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <svg class="w-4 h-4 fill-white text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          Donar Ahora
        </button>
        <a
          href="https://wa.me/573002167822"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Contactar
        </a>
      </div>
    </div>

  </article>

  <Footer />
  <FloatingWhatsApp />
  <DonationModal />
</BaseLayout>
