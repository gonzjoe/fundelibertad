---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllUnifiedPosts, type UnifiedPost } from '../../lib/blog';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getAllUnifiedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: UnifiedPost };

let Content = null;
if (post.isMarkdown && post.entry) {
  const rendered = await render(post.entry);
  Content = rendered.Content;
}
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  author={post.author}
  image={post.image}
  category={post.category}
  tags={post.tags}
>
  {Content ? (
    <Content />
  ) : (
    <div class="wp-content text-slate-700 leading-relaxed text-base space-y-6" set:html={post.content} />
  )}
</BlogPostLayout>
