---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Pagination from '../../components/blog/Pagination.astro';
import { getAllUnifiedPosts } from '../../lib/blog';
import { slugify } from '../../utils/slugify';
import { url } from '../../lib/base';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = await getAllUnifiedPosts();
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;

// Obtener categorías únicas con su conteo
const allPosts = await getAllUnifiedPosts();
const categoryCountMap = new Map<string, number>();
for (const p of allPosts) {
  if (p.category) {
    categoryCountMap.set(p.category, (categoryCountMap.get(p.category) || 0) + 1);
  }
}
const categories = Array.from(categoryCountMap.entries()).map(([name, count]) => ({
  name,
  count,
  slug: slugify(name),
}));
---

<PageLayout
  title="Blog & Actualidad | FUNDELIBERTAD"
  description="Noticias, artículos, comunicados e informes sobre derechos humanos y actividades comunitarias en Medellín."
  breadcrumbs={[
    { label: 'Blog' }
  ]}
>
  <div class="space-y-12">
    
    {/* Encabezado del Blog */}
    <header class="max-w-3xl space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-primary text-white text-xs font-bold uppercase tracking-wider">
        Publicaciones Institucionales
      </span>
      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl text-brand-dark tracking-tight leading-tight">
        Blog de Derechos Humanos & Comunidad
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Consulta nuestros artículos de opinión, informes de gestión, alertas tempranas y novedades sobre la labor social y jurídica en la Comuna 15 Guayabal y Medellín.
      </p>

      {/* Categorías Principales */}
      {categories.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="text-xs font-bold text-slate-400 self-center mr-1">Categorías:</span>
          {categories.map((cat) => (
            <a
              href={url(`/blog/categoria/${cat.slug}`)}
              class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-medium text-slate-700 hover:border-brand-primary hover:text-brand-primary transition-all shadow-2xs"
            >
              {cat.name} <span class="text-slate-400 font-bold ml-0.5">({cat.count})</span>
            </a>
          ))}
          <a
            href={url('/blog/categoria')}
            class="text-xs font-bold text-brand-primary hover:underline px-2 py-1"
          >
            Ver todas →
          </a>
        </div>
      )}
    </header>

    {/* Grilla de Artículos */}
    {page.data.length === 0 ? (
      <div class="bg-white rounded-3xl p-16 text-center border border-slate-200 shadow-xs max-w-xl mx-auto space-y-4">
        <h2 class="font-display font-bold text-2xl text-slate-800">No se encontraron artículos</h2>
        <p class="text-sm text-slate-500 leading-relaxed">
          Las publicaciones añadidas en Markdown o WordPress aparecerán aquí de forma automática.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post: any) => (
          <PostCard
            title={post.title}
            description={post.description}
            slug={post.slug}
            image={post.image}
            category={post.category}
            pubDate={post.pubDate}
            author={post.author}
          />
        ))}
      </div>
    )}

    {/* Paginación */}
    <Pagination page={page} />

  </div>
</PageLayout>
