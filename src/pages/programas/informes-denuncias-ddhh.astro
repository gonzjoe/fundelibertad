---
import Layout from '../../layouts/Layout.astro';
import ProgramSections from '../../components/sections/ProgramSections';
import { getPosts, getFeaturedImageUrl, getPostCategories, hasValidCategory } from '../../lib/wordpress';
import type { WPActivityItem } from '../../components/sections/ActivitiesSection';

// Cargar posts de WordPress pertenecientes a Informes y Denuncias de DDHH
const rawPosts = await getPosts(50);
const reportsRawPosts = rawPosts.filter(post => {
  if (post.slug === 'hello-world' || post.id === 1) return false;
  if (!hasValidCategory(post)) return false;
  const cats = getPostCategories(post);
  return cats.some(c => {
    const n = c.toLowerCase();
    return (
      n.includes('informe') ||
      n.includes('denuncia') ||
      n.includes('ddhh') ||
      n.includes('derecho')
    );
  });
});

const initialReportsPosts: WPActivityItem[] = reportsRawPosts.map(post => {
  const cats = getPostCategories(post);
  const featuredImg = getFeaturedImageUrl(post, 'https://lh3.googleusercontent.com/d/1VOAa3Fwpv9QvlaDHN7PP8mWY-jYImtzN');
  const dateStr = new Date(post.date).toLocaleDateString('es-CO', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });

  return {
    id: `wp-${post.id}`,
    title: post.title.rendered,
    category: cats[0] || 'Informes y Denuncias de DDHH',
    categories: cats,
    description: post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim(),
    content: post.content.rendered,
    image: featuredImg,
    slug: post.slug,
    date: dateStr,
  };
});
---

<Layout
  title="Informes y Denuncias de DDHH | Programas FUNDELIBERTAD"
  description="Canal confidencial de radicación e informe de vulneraciones a los derechos humanos."
>
  <ProgramSections 
    client:idle 
    initialSubsection="reports" 
    initialReportsPosts={initialReportsPosts} 
  />
</Layout>
