---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/sections/HomeSection.astro';
import { getPosts, getFeaturedImageUrl, getPostCategories, hasValidCategory } from '../lib/wordpress';
import type { WPActivityItem } from '../components/sections/ActivitiesSection';

const rawPosts = await getPosts(50);
// REGLA: Entrada que no tenga categorías no mostrarla en ningún lado
const validPosts = rawPosts.filter(hasValidCategory);

// REGLA: En "Nuestros Proyectos de Impacto", mostrar siempre los 3 últimos proyectos publicados en WordPress (sin añadir mock)
const wpProjectPosts = validPosts
  .filter((post) => {
    const cats = getPostCategories(post);
    return cats.some((c) => c.toLowerCase().includes('proyecto'));
  })
  .slice(0, 3);

const homeProjects: WPActivityItem[] = wpProjectPosts.map((post) => {
  const cats = getPostCategories(post);
  const featuredImg = getFeaturedImageUrl(
    post,
    'https://lh3.googleusercontent.com/d/11y3-Zw7P020zrMq6cakM0RrvsjrFlzW5'
  );
  const dateStr = new Date(post.date).toLocaleDateString('es-CO', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
  const specificCat =
    cats.find((c) => c.toLowerCase() !== 'proyectos') || cats[0] || 'Proyectos';

  return {
    id: `wp-${post.id}`,
    title: post.title.rendered,
    category: specificCat,
    categories: cats,
    description: post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim(),
    content: post.content.rendered,
    image: featuredImg,
    slug: post.slug,
    date: dateStr,
  };
});
---

<PageLayout title="FUNDELIBERTAD | Inicio - Defendiendo los Derechos Humanos">
  <HomeSection initialProjects={homeProjects} />
</PageLayout>
