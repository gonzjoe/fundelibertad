---
import Layout from '../layouts/Layout.astro';
import ProjectsSection from '../components/sections/ProjectsSection';
import { getPosts, getFeaturedImageUrl, getPostCategories, hasValidCategory } from '../lib/wordpress';
import type { WPActivityItem } from '../components/sections/ActivitiesSection';

// Obtener todas las entradas publicadas en WordPress
const allWpPosts = await getPosts(50);

const isNonProjectCategory = (catName: string): boolean => {
  if (!catName) return true;
  const lower = catName.toLowerCase().trim();
  if (lower === 'uncategorized' || lower === 'sin categoría' || lower === 'sin categoria') return true;
  if (lower === 'actividades' || lower === 'actividad') return true;
  if (lower.includes('denuncia') || lower.includes('informe')) return true;
  if (lower.includes('asesoria') || lower.includes('asesoría')) return true;
  if (lower.includes('pasantia') || lower.includes('pasantía') || lower.includes('práctica') || lower.includes('practica')) return true;
  return false;
};

// REGLA: En Proyectos solo van las entradas que pertenezcan a la categoría de proyectos
// y solo deben mostrarse las categorías propias de las entradas de proyectos.
const wpProjectPosts = allWpPosts.filter((post) => {
  if (!hasValidCategory(post)) return false;
  const cats = getPostCategories(post);
  return cats.some(c => c.toLowerCase().includes('proyecto'));
});

const mappedWpProjects: WPActivityItem[] = wpProjectPosts.map((post) => {
  const allCats = getPostCategories(post);
  const projectCats = allCats.filter(c => !isNonProjectCategory(c));
  const validCats = projectCats.length > 0 ? projectCats : ['Proyectos'];
  const featuredImg = getFeaturedImageUrl(post, 'https://lh3.googleusercontent.com/d/11y3-Zw7P020zrMq6cakM0RrvsjrFlzW5');
  const dateStr = new Date(post.date).toLocaleDateString('es-CO', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });

  const specificCat = validCats.find(c => c.toLowerCase() !== 'proyectos') || validCats[0] || 'Proyectos';

  return {
    id: `wp-${post.id}`,
    title: post.title.rendered,
    category: specificCat,
    categories: validCats,
    description: post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim(),
    content: post.content.rendered,
    image: featuredImg,
    slug: post.slug,
    date: dateStr,
  };
});
---

<Layout
  title="Proyectos Sociales | FUNDELIBERTAD"
  description="Iniciativas de alto impacto social, derechos humanos y convivencia ciudadana en Medellín y Antioquia."
>
  <ProjectsSection client:idle wpProjects={mappedWpProjects} />
</Layout>
